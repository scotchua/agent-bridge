__pycache__/
*.pyc
.canary-*.json
canaries/.timeout-*.json
.DS_Store
config/local.json
config/com.agent-bridge.execution-worker.plist
.release-review/

# Live relay state: state.json, locks, auth-repair working dirs. Mode 0600,
# machine-local, and never meant to be shared. Untracked was not enough: one
# `git add -A` in a dirty tree would have committed and pushed it.
.claude-codex-relay/

# Built WSL2 guest images. Hundreds of megabytes, rebuilt from a pinned
# recipe, and a new copy in history on every build. The recipe and the
# expected hashes are what is versioned; the tarball is not.
/build/
*.tar
!tests/**/*.tar
