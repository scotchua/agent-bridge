#!/bin/sh
# Local Claude/Codex consultation bridge, stdio MCP server.
# Requires --caller codex|claude. Consultation only; see README.md.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(dirname -- "$HERE")
PY=${AGENT_BRIDGE_PYTHON:-python3}
export PYTHONPATH="$REPO/src"
export PYTHONDONTWRITEBYTECODE=1
exec "$PY" -P -m agent_bridge.mcp_server "$@"
