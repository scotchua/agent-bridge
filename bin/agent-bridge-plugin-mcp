#!/bin/sh
# Claude Code plugin launcher.  It never installs Python or a provider CLI.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(dirname -- "$HERE")
export AGENT_BRIDGE_PACKAGED=1
export AGENT_BRIDGE_PLUGIN_ROOT="$REPO"
export PYTHONPATH="$REPO/src"
export PYTHONDONTWRITEBYTECODE=1
# Never import bytecode from the plugin tree: it is outside the verified digest.
# This directory is not created; the prefix only redirects the cache lookup.
export PYTHONPYCACHEPREFIX="${HOME:-}/.agent-bridge/packaged/no-bytecode"
CONFIG="${HOME:-}/.agent-bridge/packaged/config.json"
STATE="${HOME:-}/.agent-bridge"
STATE_DIR="$STATE/packaged"
PY=""
OWNER=$(id -u 2>/dev/null || true)
# The same trust policy as packaged.py: the physical HOME is owned by this user
# and not group or world writable, and every ancestor is owned by this user or
# root and not group or world writable unless sticky.  Any doubt ignores the
# recorded interpreter and falls back to PATH.
TRUSTED=""
HOME_REAL=$(CDPATH= cd -P -- "${HOME:-/nonexistent}" 2>/dev/null && pwd -P) || HOME_REAL=""
if [ -n "$OWNER" ] && [ -n "$HOME_REAL" ] && [ "$HOME_REAL" != "/" ]; then
  if [ "$(find "$HOME_REAL" -prune -type d -user "$OWNER" ! -perm -g=w ! -perm -o=w -print 2>/dev/null || true)" = "$HOME_REAL" ]; then
    TRUSTED=1
    ANCESTOR=$HOME_REAL
    while [ "$ANCESTOR" != "/" ]; do
      ANCESTOR=$(dirname -- "$ANCESTOR")
      if [ "$(find "$ANCESTOR" -prune -type d \( -user "$OWNER" -o -user 0 \) \( \( ! -perm -g=w ! -perm -o=w \) -o -perm -1000 \) -print 2>/dev/null || true)" != "$ANCESTOR" ]; then
        TRUSTED=""
        break
      fi
    done
  fi
fi
if [ -n "$TRUSTED" ] && [ -f "$CONFIG" ] && [ ! -L "$CONFIG" ] && [ ! -L "$STATE" ] && [ ! -L "$STATE_DIR" ]; then
  SAFE=$(find "$CONFIG" "$STATE_DIR" "$STATE" -prune -user "$OWNER" ! -perm -g=r ! -perm -g=w ! -perm -g=x ! -perm -o=r ! -perm -o=w ! -perm -o=x -print 2>/dev/null || true)
  if [ "$SAFE" != "$CONFIG
$STATE_DIR
$STATE" ]; then SAFE=""; fi
fi
if [ "${SAFE:-}" ]; then
  PY=$(sed -n 's/^[[:space:]]*"launcher_python"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p' "$CONFIG" | head -n 1 || true)
  case "$PY" in /*) ;; *) PY="" ;; esac
fi
for CANDIDATE in "$PY" python3 python; do
  [ -n "$CANDIDATE" ] || continue
  if [ "$CANDIDATE" = "python3" ] || [ "$CANDIDATE" = "python" ]; then CANDIDATE=$(command -v "$CANDIDATE" 2>/dev/null || true); fi
  [ -n "$CANDIDATE" ] && [ -f "$CANDIDATE" ] && [ -x "$CANDIDATE" ] || continue
  if "$CANDIDATE" -P -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec "$CANDIDATE" -P -m agent_bridge.mcp_server "$@"
  fi
done
printf '%s\n' 'agent-bridge requires Python 3.11 or newer. Install Python 3.11+ and run /agent-bridge:setup again.' >&2
exit 2
