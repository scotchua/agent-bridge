#!/bin/sh
# PreToolUse hook for Claude Code and the Codex CLI: allow an implementation
# write only while a routing receipt says this client's route owns the stage.
# Also `install`, `report` and `audit` subcommands. See docs/DELEGATION-GATE.md.
#
# Hook mode must never fail open. The gate itself always exits 0 and carries
# its decision in the JSON on stdout, but that contract only starts once the
# interpreter is running. If the interpreter cannot start at all, this script
# used to exit non-zero with nothing on stdout, and a host reads a hook that
# failed to produce a decision as a non-blocking error and runs the tool
# anyway. So a launch failure is turned into a deny here.
set -u
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(dirname -- "$HERE")
. "$HERE/agent-bridge-python"
python_available=true
if ! agent_bridge_resolve_python; then
  python_available=false
fi
export PYTHONPATH="$REPO/src"
export PYTHONDONTWRITEBYTECODE=1
# Both hosts emit raw UTF-8 and the gate decodes its payload as UTF-8
# explicitly; this covers everything else in the process.
export PYTHONUTF8=1

# The subcommands are operator tools, not hook mode: their exit status is
# meaningful and must be passed through rather than turned into a decision.
case "${1:-}" in
  install|report|audit|-h|--help)
    if [ "$python_available" = false ]; then
      printf '%s\n' "$AGENT_BRIDGE_PYTHON_FAILURE" >&2
      exit 2
    fi
    exec "$PY" -P -m agent_bridge.orchestration.gate "$@"
    ;;
esac

# PostToolUse only measures output after a tool has finished; it never makes a
# permission decision.  Determine that mode from argv before starting the
# child, including when the child later returns malformed output.
post_event=false
previous=""
for word in "$@"; do
  if [ "$previous" = "--event" ] && [ "$word" = "PostToolUse" ]; then
    post_event=true
    break
  fi
  previous=$word
done

if [ "$python_available" = false ]; then
  if [ "$post_event" = true ]; then
    printf '%s\n' "{}"
    exit 0
  fi
  printf '%s\n' "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"delegation-first gate: ${AGENT_BRIDGE_PYTHON_FAILURE}; nothing is implemented until the installation is repaired [gate_launcher_failed]\"}}"
  exit 0
fi

# Do not let a child that has printed a decision make that decision visible
# until it has exited cleanly.  A signal after stdout was written used to make
# the host receive both that (possibly allow) decision and our fail-closed
# fallback below.  The file also lets us reject a malformed or multi-document
# reply without exposing its raw contents.
umask 077
output=$(mktemp "${TMPDIR:-/tmp}/agent-bridge-gate-hook.XXXXXX" 2>/dev/null) || {
  printf '%s\n' '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "delegation-first gate: the launcher could not prepare its decision channel; nothing is implemented until the installation is repaired [gate_launcher_failed]"}}'
  exit 0
}
trap 'rm -f "$output"' EXIT HUP INT TERM
"$PY" -P -m agent_bridge.orchestration.gate "$@" >"$output" 2>/dev/null
status=$?

if [ "$status" -eq 0 ]; then
  # A normal PreToolUse reply is either {} (an unlogged allow) or one
  # hookSpecificOutput decision.  json.load consumes the whole stream, so a
  # second decision is rejected too.  This validator deliberately emits
  # nothing: only the verified child reply is ever forwarded.
  if "$PY" -P -c '
import json
import sys

value = json.load(sys.stdin)
decision = value.get("hookSpecificOutput") if isinstance(value, dict) else None
valid = (
    isinstance(value, dict)
    and (not value or (
        isinstance(decision, dict)
        and decision.get("hookEventName") == "PreToolUse"
        and decision.get("permissionDecision") in ("allow", "deny")
    ))
)
raise SystemExit(0 if valid else 1)
' <"$output" >/dev/null 2>&1; then
    cat "$output"
    exit 0
  fi
  if [ "$post_event" = true ]; then
    printf '%s\n' "{}"
    exit 0
  fi
  printf '%s\n' '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "delegation-first gate: the hook returned no valid decision; nothing is implemented until the installation is repaired [gate_launcher_failed]"}}'
  exit 0
fi

# POSIX shells conventionally report a signal as 128 plus its number.  Keep
# that class visible to the operator while retaining the fixed, sanitized
# launcher diagnostic code.  Other nonzero results are ordinary child exits.
if [ "$status" -gt 128 ] && [ "$status" -le 255 ]; then
  signal=$((status - 128))
  failure="child signal ${signal} (status ${status})"
else
  failure="child exit ${status}"
fi
if [ "$post_event" = true ]; then
  printf '%s\n' "{}"
  exit 0
fi
printf '%s\n' "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"delegation-first gate: the hook failed (${failure}); nothing is implemented until the installation is repaired [gate_launcher_failed]\"}}"
exit 0
